# common
_PROMPT_HOST=%m
_PROMPT_PATH_BG=153
_PROMPT_PATH_FG=018
_PROMPT_TIME_BG=255
_PROMPT_TIME_FG=240
_PROMPT_HOST_BG=195
_PROMPT_HOST_FG=039
_PROMPT_CHAR_BG=157
_PROMPT_CHAR_FG=034
_PROMPT_ERROR_BG=196
_PROMPT_ERROR_FG=226

# local
_PROMPT_HOST_BG=195
_PROMPT_HOST_FG=039
_PROMPT_HOST=aer


if _has_color
then
    export COLORTERM=1
    _OPT_COLOR=--color=auto
    _init_color_prompt
fi
