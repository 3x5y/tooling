
# if not running interactively, do nothing
case $- in
    *i*) ;;
      *) return;;
esac


## functions


_is_root() {
    [[ $(id -u) -eq 0 ]]
}


_is_xterm() {
    [[ $TERM =~ ^xterm|^rxvt ]]
}


_has_color() {
    # trust these values
    [[ $TERM =~ ^xterm-color$|-256color$ ]] && return 0

    # fallback for other terminals
    _has_exe tput && tput setaf 1 >&/dev/null
}


_has_exe() {
    type -p "$1" &>/dev/null
}


_clear_termtitle() {
    printf '\e]0;\a'
}


_do_bash_completion() {
    shopt -oq posix && return
    test "$BASH_COMPLETION_VERSINFO" && return

    local f
    local paths=(/usr/share/bash-completion/bash_completion
                 /etc/bash_completion)
    for f in "${paths[@]}"
    do
        test -f "$f" && echo "source $f" && return
    done
}


_dirstack_list() {
    local out=$(dirs -p | tail -n+2 | cat -n)
    if [[ "$out" ]]
    then
        echo "$out"
    else
        return 1
    fi
}


_dirstack_go() {
    _pushd_rotate +$1
}


_dirstack_dispatch() {
    local n
    if [[ "$1" =~ ^[1-9][0-9]*$ ]]
    then
        _dirstack_go "$1"
        return
    fi
    _dirstack_list || return 1
    echo -n '> '
    read -t 5 n || { echo; return; }
    if [[ "$n" =~ ^[1-9][0-9]*$ && $n -gt 0 ]]
    then
        _dirstack_go $n >/dev/null
    else
        ! [[ "$n" ]]
    fi
}


_up_list() {
    local lines=$(echo "$PWD" | tr / \\n)
    local n=$(echo "$lines" | wc -l)
    ((n > 3)) || return 1
    echo "$lines" | tail -n+2  | head -n $((n-2)) | tac | cat -n | tac
}


_up_go() {
    local n=$1
    local d=..
    local m=$(echo "$PWD" | tr / \\n | wc -l)
    ((n>m)) && n=$m
    ((n<1)) && return 1
    while [[ $((--n)) -gt 0 ]]
    do
        d="$d/.."
    done
    _cd_pushd $d
}


_up_dispatch() {
    local n
    if [[ "$1" =~ ^[1-9][0-9]*$ ]]
    then
        _up_go "$1"
        return
    fi
    _up_list || { _cd_pushd ..; return; }
    echo -n '> '
    read -t 5 n || { echo; return; }
    if [[ "$n" =~ ^[1-9][0-9]*$ && $n -gt 0 ]]
    then
        _up_go $n
    else
        ! [[ "$n" ]]
    fi
}


_list_history() {
    local n=${1:-20}
    history $n
}


# bash implemntation of zsh functionality


_cd_pushd() {
    #builtin cd "$@" && _popd_uniq "$PWD" \
    builtin cd "$@" \
        && _popd_uniq "$PWD" >/dev/null \
        && pushd -n "$OLDPWD" >/dev/null
}


_pushd_rotate() {
        local n=$1
        local d="${DIRSTACK[n]}"
        popd -n +$n
        pushd "$d"
}


_popd_uniq() {
    local popped=0 i=0 d
    for i in "${!DIRSTACK[@]}"
    do
        [[ $i -eq 0 ]] && continue
        d=${DIRSTACK[i]}
        #echo "$i: $d"
        if [[ "$d" = "$1" ]]
        then
            #echo "popd -n +$i"
            popd -n +$i
            ((popped++))
        fi
    done

    if (( $i - $popped > $DIRSTACKSIZE - 1))
    then
        #echo " (( $i - $popped > $DIRSTACKSIZE )) "
        #echo "extra popd -n +$i"
        popd -n +$i
    fi
}


_init_color_prompt() {
    local time='${_PROMPT_TIME}'
    local end_bg='${_PROMPT_STATUS_BG}'
    local end_fg='${_PROMPT_STATUS_FG}'
    local path_esc="\e[48;5;${_PROMPT_PATH_BG}m\e[38;5;${_PROMPT_PATH_FG}m\e[1m"
    local host_esc="\e[48;5;${_PROMPT_HOST_BG}m\e[38;5;${_PROMPT_HOST_FG}m\e[1m"
    local time_esc="\e[48;5;${_PROMPT_TIME_BG}m\e[38;5;${_PROMPT_TIME_FG}m"
    local end_esc="\e[48;5;${end_bg}m\e[38;5;${end_fg}m\e[1m"
    local ps_reset='\[\e[0m\]'
    local ps_path="\[$path_esc\]\w"
    local ps_host="\[$host_esc\]\h:"
    local ps_host="\[$host_esc\]$_PROMPT_HOST:"
    local ps_time="\[$time_esc\]${time}"
    local ps_end="\[$end_esc\]"'\$'
    PS1="${ps_path}${ps_reset}\n${ps_time}${ps_host}${ps_end}${ps_reset} "
    _USE_FANCY_PROMPT=1
}


_update_prompt_vars() {
    [[ "$_USE_FANCY_PROMPT" ]] || return
    if (( $_LAST_COMMAND_STATUS ))
    then
        _PROMPT_STATUS_BG=$_PROMPT_ERROR_BG
        _PROMPT_STATUS_FG=$_PROMPT_ERROR_FG
    else
        _PROMPT_STATUS_BG=$_PROMPT_CHAR_BG
        _PROMPT_STATUS_FG=$_PROMPT_CHAR_FG
    fi
    _PROMPT_TIME=$(date -u +%H:%M)
}


_prompt_command() {
    _LAST_COMMAND_STATUS=$?
    history -a
    _update_prompt_vars
}


_config_ssh_host() {
    local host=$1
    local addr=$2
    local user=${3:-$USER}
    [ "$host" ] || { echo usage: "config-ssh-host host addr [user]"; return 1; }
    [ "$addr" ] || { echo usage: "config-ssh-host host addr [user]"; return 1; }
    if grep -qi "^ *host  *$host$" .ssh/config
    then
        echo "host entry exists in ~/.ssh/config; aborting"
        return 1
    fi
    local keyfile=~/.ssh/id_${HOSTNAME}_$host_$(date +%Y%m%d)
    [ -f $keyfile ] && { echo "$keyfile exists; aborting"; return 1; }
    local comment="$HOSTNAME:$host"
    local ssh_config="host $host
    hostname $addr
    identityfile $keyfile
    user $user"
    ssh-keygen -t ed25519 -f $keyfile -C "$comment"
    echo "$ssh_config" >> ~/.ssh/config
    ssh-copy-id -i $keyfile $host
    echo "attempting to ssh to $host"
    ssh $host
}


hashdir() {
    (cd "$1" \
        && find -type f -print0 \
        | LANG=C sort -z \
        | xargs -0 b3sum
    ) | b3sum | cut -d' ' -f1
}


mksshkey() {
    [ "$HOSTNAME" ] || { echo HOSTNAME not set >&2; return 1; }
    [ "$1" ] || { echo require argument >&2; return 2; }
    local arg=$1
    local d=$(date +%Y%m%d)
    local f="$d"_"$HOSTNAME"_$arg
    local c="$d:$HOSTNAME:$arg"
    local nl=$'\n'
    local entry="host $arg$nl    identityfile ~/.ssh/$f"
    local line vimline
    if [ -s ~/.ssh/config ]
    then
        line=$(wc -l ~/.ssh/config | cut -d' ' -f1)
        vimline=+$((line + 2))
        entry="$nl$entry"
    fi

    ssh-keygen -t ed25519 -f ~/.ssh/"$f" -C "$c" \
        && echo "$entry" >> ~/.ssh/config \
        && vim ~/.ssh/config $vimline
}


confirm() {
    read -p 'enter y to continue: ' && [[ $REPLY = y ]]
}


