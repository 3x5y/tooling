bind 'set show-all-if-ambiguous on'
bind '"\e[A":history-search-backward'
bind '"\e[B":history-search-forward'


# conditional settings

eval $(_do_bash_completion)


if _is_root
then
    _PROMPT_PATH_BG=252
    _PROMPT_PATH_FG=160
    _PROMPT_HOST_BG=220
    _PROMPT_HOST_FG=160
    _PROMPT_CHAR_BG=252
    _PROMPT_CHAR_FG=160
fi


if _has_color
then
    _GREP_OPTS=--color=auto
    _LS_OPTS=--color=auto
    _init_color_prompt
    _has_exe dircolors \
        && eval "$(dircolors -b)"
    _has_exe colordiff \
        && alias diff=colordiff
    alias diff='diff --color'
fi


if _is_xterm
then
    PS1='\[\e]0;\u@\h: \w\a\]'"$PS1"
fi


