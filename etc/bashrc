_PROMPT_PATH_BG=014
_PROMPT_PATH_FG=004
_PROMPT_TIME_BG=000
_PROMPT_TIME_FG=250
_PROMPT_HOST_BG=250
_PROMPT_HOST_FG=004
_PROMPT_CHAR_BG=157
_PROMPT_CHAR_FG=034
